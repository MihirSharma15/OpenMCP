# Clerk dashboard -> API keys. Never commit actual values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Account FastAPI origin; must be HTTPS or loopback HTTP. No /v1 suffix.
OPENMCP_API_URL=http://127.0.0.1:8000
# Public origin shown in connection instructions (may differ from internal API).
OPENMCP_PUBLIC_API_URL=http://127.0.0.1:8000
# Exact website origin for mutation CSRF validation behind a reverse proxy.
OPENMCP_APP_ORIGIN=http://localhost:3000
