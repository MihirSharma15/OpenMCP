[
  {
    "provider_id": "tavily",
    "name": "Tavily",
    "description": "Basic and advanced web search with general/news/finance topic filters, Markdown extraction from batches of up to five public HTTPS pages, and one-level website URL mapping. Finance means web search about finance, not a financial database. OpenMCP does not expose Tavily answer generation or recursive crawling.",
    "secret_ref": "TAVILY_API_KEY",
    "queries": [
      {
        "endpoint_id": "tavily-web-search",
        "name": "Tavily Basic web search",
        "description": "Find web sources for query (1\u2013400 characters) using basic search. Returns titles, URLs and content excerpts, not full pages or a generated answer. max_results is 1\u201320, default 10. Optional topic general/news/finance (default general), time_range day/week/month/year, and include_domains/exclude_domains (up to ten each). Uses one Tavily search credit.",
        "keywords": [
          "web",
          "search",
          "news",
          "research"
        ],
        "url": "https://api.tavily.com/search",
        "recipient": "",
        "settlement": "api_key",
        "adapter": "tavily",
        "price_cents": 2,
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "topic": {
              "type": "string",
              "enum": [
                "general",
                "news",
                "finance"
              ],
              "default": "general"
            },
            "time_range": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            },
            "include_domains": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
              }
            },
            "exclude_domains": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
              }
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "provider": {
              "const": "Tavily"
            },
            "endpoint_id": {
              "const": "tavily-web-search"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "provider",
            "endpoint_id",
            "results"
          ]
        },
        "enabled": true,
        "mode": "test",
        "supports_idempotency": true
      },
