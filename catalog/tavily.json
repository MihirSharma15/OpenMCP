      {
        "endpoint_id": "tavily-web-search",
        "name": "Tavily Basic web search",
        "description": "Search up to 20 web pages with titles, source URLs, and excerpts. Supports news/finance, recency, and domain filters. Uses one Tavily credit.",
        "keywords": [
          "web",
          "search",
          "news",
          "research"
        ],
        "url": "https://api.tavily.com/search",
        "recipient": "",
        "settlement": "api_key",
        "adapter": "tavily",
        "price_cents": 2,
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "max_results": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "topic": {
              "type": "string",
              "enum": [
                "general",
                "news",
                "finance"
              ],
              "default": "general"
            },
            "time_range": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            },
            "include_domains": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
              }
            },
            "exclude_domains": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
              }
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "provider": {
              "const": "Tavily"
            },
            "endpoint_id": {
              "const": "tavily-web-search"
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "provider",
            "endpoint_id",
            "results"
          ]
        },
        "enabled": true,
        "mode": "test",
        "supports_idempotency": true
