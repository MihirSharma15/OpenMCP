[
  {
    "provider_id": "dataforseo",
    "name": "DataForSEO",
    "description": "Google organic search results and SEO keyword research through three OpenMCP queries: first-page Google results, metrics for a keyword batch, and related keyword ideas. Supports location/language selection; does not provide other DataForSEO products or paid enrichment.",
    "secret_ref": "DATAFORSEO_AUTH",
    "queries": [
      {
        "endpoint_id": "dataforseo-google-search",
        "name": "DataForSEO Google search results",
        "description": "Find the first page of Google organic results for keyword (1\u2013700 characters). Returns up to ten titles, URLs, snippets and rankings, plus available SERP feature types. location_code defaults to 2840 (United States), language_code to en, and device to desktop (mobile supported). Use plain text without colons or percent escapes. Does not retrieve page contents or paid enrichment.",
        "keywords": [],
        "url": "https://sandbox.dataforseo.com/v3/serp/google/organic/live/advanced",
        "recipient": "",
        "settlement": "api_key",
        "adapter": "dataforseo",
        "price_cents": 2,
        "input_schema": {
          "type": "object",
          "properties": {
            "location_code": {
              "type": "integer",
              "minimum": 1,
              "default": 2840,
              "description": "DataForSEO location code. Defaults to 2840 (United States)."
            },
            "language_code": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[A-Za-z]{2,4})?$",
              "default": "en",
              "description": "Language code; defaults to English (en)."
            },
            "keyword": {
              "type": "string",
              "minLength": 1,
              "maxLength": 700,
              "pattern": "^[^:%]+$",
              "description": "Plain-text Google search query, without colon operators or percent escapes."
            },
            "device": {
              "type": "string",
              "enum": [
                "desktop",
                "mobile"
              ],
              "default": "desktop"
            }
          },
          "required": [
            "keyword"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "provider": {
              "const": "DataForSEO"
            },
            "endpoint_id": {
              "const": "dataforseo-google-search"
            },
            "is_demo_data": {
              "type": "boolean"
            },
            "query": {
              "type": "object"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "provider",
            "endpoint_id",
            "is_demo_data",
            "query",
            "items"
          ]
        },
        "enabled": true,
        "mode": "test",
        "supports_idempotency": true
      },
      {
        "endpoint_id": "dataforseo-keyword-metrics",
        "name": "DataForSEO Google keyword metrics",
        "description": "Compare Google SEO metrics for keywords: 1\u2013100 unique phrases, each at most 80 characters and ten words. Returns available search volume, monthly search trends, CPC, paid-search competition, organic difficulty, intent and update timestamps. location_code defaults to 2840 (United States) and language_code to en. Uses the monthly keyword database; unknown keywords or individual metrics may be missing.",
        "keywords": [],
        "url": "https://sandbox.dataforseo.com/v3/dataforseo_labs/google/keyword_overview/live",
        "recipient": "",
        "settlement": "api_key",
        "adapter": "dataforseo",
        "price_cents": 5,
        "input_schema": {
          "type": "object",
          "properties": {
            "location_code": {
              "type": "integer",
              "minimum": 1,
              "default": 2840,
              "description": "DataForSEO location code. Defaults to 2840 (United States)."
            },
            "language_code": {
              "type": "string",
              "pattern": "^[a-z]{2}(-[A-Za-z]{2,4})?$",
              "default": "en",
              "description": "Language code; defaults to English (en)."
            },
            "keywords": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^\\s*\\S+(?:\\s+\\S+){0,9}\\s*$"
              },
              "description": "Keywords to research; each phrase has at most 80 characters and 10 words."
            }
          },
          "required": [
            "keywords"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "provider": {
              "const": "DataForSEO"
            },
            "endpoint_id": {
              "const": "dataforseo-keyword-metrics"
            },
            "is_demo_data": {
              "type": "boolean"
            },
            "query": {
              "type": "object"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "provider",
            "endpoint_id",
            "is_demo_data",
            "query",
            "items"
          ]
        },
        "enabled": true,
        "mode": "test",
        "supports_idempotency": true
      },
      {
        "endpoint_id": "dataforseo-related-keywords",
        "name": "DataForSEO related Google keyword ideas",
        "description": "Generate related Google keyword ideas from a seed keyword (at most 80 characters and ten words). limit is 1\u2013100, default 100; fewer ideas may be available and the seed itself is excluded. Returns available search volume, CPC, competition, difficulty, intent, monthly trends and update timestamps. location_code defaults to 2840 (United States), language_code to en. Uses related-search and keyword databases rather than fetching webpage contents.",
        "keywords": [],
        "url": "https://sandbox.dataforseo.com/v3/dataforseo_labs/google/related_keywords/live",
        "recipient": "",
        "settlement": "api_key",
        "adapter": "dataforseo",
        "price_cents": 5,
        "input_schema": {
          "type": "object",
          "properties": {
            "location_code": {
