            },
            "endpoint_id": {
              "const": "dataforseo-related-keywords"
            },
            "is_demo_data": {
              "type": "boolean"
            },
            "query": {
              "type": "object"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "provider",
            "endpoint_id",
            "is_demo_data",
            "query",
            "items"
