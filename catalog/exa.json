[
  {
    "provider_id": "exa",
    "name": "Exa",
    "description": "Web search and public webpage text for agent research.",
    "secret_ref": "EXA_API_KEY",
    "queries": [
      {
        "endpoint_id": "exa-search",
        "name": "Exa Search the web",
        "description": "Search up to ten web results using Exa auto search. Returns titles, URLs and publication metadata. No deep research or content enrichment. Flat $0.02 per successful request.",
        "keywords": [
          "web",
          "research",
          "search"
        ],
        "url": "https://api.exa.ai/search",
        "recipient": "",
        "settlement": "api_key",
        "adapter": "exa",
        "price_cents": 2,
        "input_schema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 10
            },
            "category": {
              "type": "string",
              "enum": [
                "company",
                "publication",
                "news",
                "personal site",
                "financial report",
                "people"
              ]
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "provider": {
              "const": "Exa"
            },
            "endpoint_id": {
              "const": "exa-search"
            }
          },
          "required": [
            "provider",
            "endpoint_id"
          ]
        },
        "enabled": true,
        "mode": "test",
        "supports_idempotency": true
      },
      {
        "endpoint_id": "exa-contents",
        "name": "Exa Retrieve webpage text",
        "description": "Retrieve text from one public HTTPS page, capped at 20,000 characters. No summaries, highlights, subpage crawling or paid enrichment. Flat $0.02 per successful request.",
        "keywords": [
          "web",
          "research",
          "contents"
        ],
        "url": "https://api.exa.ai/contents",
        "recipient": "",
        "settlement": "api_key",
        "adapter": "exa",
        "price_cents": 2,
        "input_schema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://"
            },
            "max_characters": {
              "type": "integer",
              "minimum": 100,
              "maximum": 20000,
              "default": 10000
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "provider": {
              "const": "Exa"
            },
            "endpoint_id": {
              "const": "exa-contents"
            }
          },
          "required": [
            "provider",
            "endpoint_id"
          ]
        },
        "enabled": true,
        "mode": "test",
        "supports_idempotency": true
      }
    ]
  }
]
