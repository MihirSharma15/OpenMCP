        "keywords": [
          "web",
          "scrape",
          "extract",
          "html",
          "markdown"
        ],
        "url": "https://api.firecrawl.dev/v2/scrape",
        "recipient": "",
        "settlement": "api_key",
        "adapter": "firecrawl",
