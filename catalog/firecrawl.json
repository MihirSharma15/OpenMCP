              "default": "web"
            },
            "time_range": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$",
              "default": "US"
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
