# `uv run openmcp init` creates five fresh testnet wallets and random local secrets.
# The legacy demo below uses testnet wallets; account-mode Stripe config follows.
OPENMCP_API_TOKEN=replace-with-a-random-token
OPENMCP_MPP_SECRET=replace-with-a-random-secret
OPENMCP_BUDGET_CENTS=1500
OPENMCP_FEE_BPS=1000
OPENMCP_DATABASE=.openmcp/mpp.sqlite3
# Optional Postgres credit ledger. Empty leaves /v1/credits in memory.
# When set, `openmcp serve` migrates this separate legacy database.
# OPENMCP_LEGACY_DATABASE_URL=postgresql://openmcp:openmcp@localhost:5433/openmcp
OPENMCP_CATALOG=catalog/providers.json
OPENMCP_WALLETS=.openmcp/wallets
OPENMCP_BASE_URL=http://127.0.0.1:8000
OPENMCP_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431

# Optional API Creator. Install with `uv sync --extra creator`.
# Choose a model available from your inference provider; no model is silently selected.
OPENMCP_CREATOR_BASE_URL=http://127.0.0.1:9002
OPENMCP_CREATOR_INFERENCE_BASE_URL=https://api.openai.com/v1
OPENMCP_CREATOR_INFERENCE_API_KEY=
OPENMCP_CREATOR_MODEL=
OPENMCP_CREATOR_MAX_OUTPUT_TOKENS=6000
OPENMCP_CREATOR_HEADLESS=true

# Optional backend AgentCard integration. The existing Tempo demo does not load these.
# Credentials determine mode at the same API host; the adapter verifies this expectation.
# AGENTCARD_CLIENT_ID=your-sandbox-client-id
# AGENTCARD_CLIENT_SECRET=your-sandbox-client-secret
# AGENTCARD_TEST_MODE=true
# AGENTCARD_TIMEOUT_SECONDS=30
# AGENTCARD_WEBHOOK_SECRET=secret-from-your-sandbox-webhook-endpoint

# Account-backed MVP (separate from the legacy testnet demo above).
# Start API with `openmcp serve --mode account`; both API and worker require Postgres.
OPENMCP_PRODUCT_MODE=test
# OPENMCP_PRODUCT_DATABASE_URL=postgresql://openmcp:openmcp@localhost:5433/openmcp
OPENMCP_PRODUCT_DATABASE_SCHEMA=openmcp_product
OPENMCP_DATABASE_PROVIDER=postgres
OPENMCP_DATABASE_POOL_MAX=4
# Supabase: set provider=supabase and use the Connect dialog's direct/session URI.
# Use a dedicated runtime role, sslmode=verify-full and sslrootcert=/path/to/prod-ca-2021.crt.
# Never use port 6543: the payment worker requires a persistent database session.
# Run migrations separately before startup: python -m openmcp.product.cli migrate
# Privileged deployment only (export for that command, never on the web runtime):
# OPENMCP_PRODUCT_MIGRATION_DATABASE_URL=postgresql://...
# Check connectivity without Clerk/Stripe: python -m openmcp.product.cli database-check
OPENMCP_PRODUCT_FRONTEND_URL=http://localhost:3000
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# Optional pinned PEM; otherwise issuer's /.well-known/jwks.json is used.
# CLERK_JWT_KEY=
# CLERK_AUDIENCE=
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_API_VERSION=2025-02-24.acacia
# Enable Link in Stripe Dashboard payment method settings (dynamic Checkout methods).
# Subscribe: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded,
# charge.dispute.created, charge.dispute.updated, charge.dispute.closed,
# charge.dispute.funds_withdrawn, charge.dispute.funds_reinstated.
# OPENMCP_PRODUCT_CATALOG=/absolute/path/to/approved-services.json
# OPENMCP_TREASURY_KEY_FILE=/private/path/platform-key.json
OPENMCP_TREASURY_RPC_URL=https://rpc.moderato.tempo.xyz
OPENMCP_TREASURY_CHAIN_ID=42431
OPENMCP_TREASURY_TOKEN=0x20c0000000000000000000000000000000000000
OPENMCP_TREASURY_EXPLORER_URL=https://explore.moderato.tempo.xyz
OPENMCP_TREASURY_FEE_RESERVE_CENTS=10
OPENMCP_PRODUCT_PROVIDER_TIMEOUT=30
OPENMCP_PRODUCT_WORKER_INTERVAL=2
OPENMCP_PRODUCT_RETRY_SECONDS=15
OPENMCP_PRODUCT_MAX_ATTEMPTS=5
# LIVE: requires sk_live_, production Clerk/HTTPS origins, approved live catalog,
# owner-only treasury key file, and separately funded mainnet USDC:
# OPENMCP_PRODUCT_MODE=live
# OPENMCP_TREASURY_CHAIN_ID=4217
# OPENMCP_TREASURY_RPC_URL=https://rpc.tempo.xyz
# OPENMCP_TREASURY_TOKEN=0x20C000000000000000000000b9537d11c60E8b50
# OPENMCP_TREASURY_EXPLORER_URL=https://explore.tempo.xyz
