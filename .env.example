# Account API and worker. Keep actual credentials in ignored .env or deployment secrets.
# Start with `openmcp serve` and `openmcp worker`; both require PostgreSQL.
OPENMCP_PRODUCT_MODE=test
# OPENMCP_PRODUCT_DATABASE_URL=postgresql://openmcp:openmcp@localhost:5433/openmcp
OPENMCP_PRODUCT_DATABASE_SCHEMA=openmcp_product
OPENMCP_DATABASE_PROVIDER=postgres
OPENMCP_DATABASE_POOL_MAX=4
# Supabase: set provider=supabase and use the Connect dialog's direct/session URI.
# Use a dedicated runtime role, sslmode=verify-full and sslrootcert=/path/to/prod-ca-2021.crt.
# Never use port 6543: the payment worker requires a persistent database session.
# Run migrations separately before startup: openmcp migrate
# Privileged deployment only (export for that command, never on the web runtime):
# OPENMCP_PRODUCT_MIGRATION_DATABASE_URL=postgresql://...
# Check connectivity without Clerk/Stripe: openmcp database-check
OPENMCP_PRODUCT_FRONTEND_URL=http://localhost:3000
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# Optional pinned PEM; otherwise issuer's /.well-known/jwks.json is used.
# CLERK_JWT_KEY=
# CLERK_AUDIENCE=
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_API_VERSION=2025-02-24.acacia
# Enable Link in Stripe Dashboard payment method settings (dynamic Checkout methods).
# Subscribe: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded,
# charge.dispute.created, charge.dispute.updated, charge.dispute.closed,
# charge.dispute.funds_withdrawn, charge.dispute.funds_reinstated.
# Publish services explicitly with `openmcp providers register NAME`; see docs/providers.md.
# An API-key provider sets secret_ref to an environment variable name.
# Put the bearer token in that variable, never in the catalog JSON.
# DataForSEO uses adapter=dataforseo and HTTP Basic authentication instead:
# DATAFORSEO_AUTH=<base64 of API login:API password, without the Basic prefix>
# TAVILY_API_KEY=<private Tavily key; worker only>
# Paid replacement-cost estimate: Tavily PAYG is $0.008/credit.
TAVILY_CREDIT_COST_MICROUSD=8000
# OPENWEATHER_API_KEY=<private OpenWeather key; worker only>
# Current/5-day Free collection has no per-request cash charge; not One Call.
OPENWEATHER_REQUEST_COST_MICROUSD=0
# EXA_API_KEY=<private Exa key; worker only>
# FIRECRAWL_API_KEY=<private Firecrawl key; worker only>
# Paid replacement-cost estimate: Firecrawl Hobby top-ups are $5/1000 credits.
FIRECRAWL_CREDIT_COST_MICROUSD=5000
# The worker needs a signer only for enabled MPP services or unfinished MPP payments.
# OPENMCP_TREASURY_KEY_FILE=/private/path/platform-key.json
OPENMCP_TREASURY_RPC_URL=https://rpc.moderato.tempo.xyz
OPENMCP_TREASURY_CHAIN_ID=42431
OPENMCP_TREASURY_TOKEN=0x20c0000000000000000000000000000000000000
OPENMCP_TREASURY_EXPLORER_URL=https://explore.moderato.tempo.xyz
OPENMCP_TREASURY_FEE_RESERVE_CENTS=10
OPENMCP_PRODUCT_PROVIDER_TIMEOUT=30
OPENMCP_PRODUCT_WORKER_INTERVAL=2
OPENMCP_PRODUCT_RETRY_SECONDS=15
OPENMCP_PRODUCT_MAX_ATTEMPTS=5
# LIVE: requires sk_live_ or rk_live_ and production Clerk/HTTPS origins.
# MPP settlement additionally needs a registered service, private signer, and funded mainnet USDC:
# OPENMCP_PRODUCT_MODE=live
# OPENMCP_TREASURY_CHAIN_ID=4217
# OPENMCP_TREASURY_RPC_URL=https://rpc.tempo.xyz
# OPENMCP_TREASURY_TOKEN=0x20C000000000000000000000b9537d11c60E8b50
# OPENMCP_TREASURY_EXPLORER_URL=https://explore.tempo.xyz

# COMPANIES_HOUSE_API_KEY=<private live public-data API key; worker only>

# DEEPGRAM_API_KEY=<private transcription key; worker only>
# Exact trusted HTTPS audio hostnames, comma-separated; never wildcard domains.
# Add your controlled object-storage host to accept your WAV assets.
DEEPGRAM_AUDIO_HOSTS=static.deepgram.com

# BuiltWith free domain summary and technology trends (worker only).
BUILTWITH_API_KEY=

# Nansen: worker-only API key; purchased-credit replacement cost ($10 / 10,000).
# Included/trial credits do not change the advertised retail query price.
NANSEN_API_KEY=
NANSEN_CREDIT_COST_MICROUSD=1000

# API2PDF: private worker-only key; test mode still consumes vendor credit.
API2PDF_API_KEY=

# API Creator (optional): uv sync --extra creator, then playwright install chromium.
# Tokens must differ and each contain at least 16 characters.
OPENMCP_CREATOR_ADMIN_TOKEN=
OPENMCP_CREATOR_API_TOKEN=
OPENMCP_CREATOR_STATE_DIR=.openmcp/creator
# Public service origin; use HTTPS behind a reverse proxy for a live account deployment.
OPENMCP_CREATOR_BASE_URL=http://127.0.0.1:9002
OPENMCP_CREATOR_INFERENCE_BASE_URL=https://api.openai.com/v1
OPENMCP_CREATOR_INFERENCE_API_KEY=
# Choose a model offered by your inference provider; none is selected automatically.
OPENMCP_CREATOR_MODEL=
OPENMCP_CREATOR_MAX_OUTPUT_TOKENS=6000
OPENMCP_CREATOR_HEADLESS=true
